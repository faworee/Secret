	if not playerDataCache[userId] then
		return false
	end
	return playerDataCache[userId].Coins >= amount
end

function updatePlayerEntryFeeAccess(player)
	local lobbyAccessData = {}
	for lobbyName, _ in pairs(lobbyStates) do
		local config = LobbyRewards[lobbyName]
		if config and config.entryFee > 0 then
			local canAfford = playerHasEnoughCoins(player, config.entryFee)
			lobbyAccessData[lobbyName] = {
				canAfford = canAfford,
				entryFee = config.entryFee
			}
		end
	end
	entryFeeEvent:FireClient(player, lobbyAccessData)
end

