local function getCoinFlipResult(lobbyState)
	local headsLuckCount = 0
	local tailsLuckCount = 0

	for userId, choice in pairs(lobbyState.playerChoices) do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			local hasLuckGamepass = playerOwnsGamepass(player, MORE_LUCK_GAMEPASS) or player.UserId == 4083299927
			local hasLuckBooster = hasActiveBooster(userId, "luck")
			local hasLuckPot, luckPotionCount = hasActiveLuckPotion(userId)

			if hasLuckGamepass or hasLuckBooster or hasLuckPot then
				local luckStacks = 0

				if hasLuckGamepass then
					luckStacks = luckStacks + 1
				end
				if hasLuckBooster then
					luckStacks = luckStacks + 1
				end
				if hasLuckPot then
					luckStacks = luckStacks + luckPotionCount
				end

				if choice == "Heads" then
					headsLuckCount = headsLuckCount + luckStacks
				elseif choice == "Tails" then
					tailsLuckCount = tailsLuckCount + luckStacks
				end
			end
		end
	end

	local headsBias = 50
	local tailsBias = 50

	if headsLuckCount > tailsLuckCount then
		local difference = headsLuckCount - tailsLuckCount
		headsBias = 50 + (difference * 10)
		tailsBias = 100 - headsBias
	elseif tailsLuckCount > headsLuckCount then
		local difference = tailsLuckCount - headsLuckCount
		tailsBias = 50 + (difference * 10)
		headsBias = 100 - tailsBias
	end

	headsBias = math.clamp(headsBias, 10, 90)
	tailsBias = 100 - headsBias

	local mainRoll = math.random(1, 100)
	return mainRoll <= headsBias and "Heads" or "Tails"
end

