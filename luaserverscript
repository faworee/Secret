Players.PlayerRemoving:Connect(function(player)
	local userId = player.UserId

	playerIsLeaving[userId] = true

	local playtime = 0
	if playerJoinTimes[userId] then
		playtime = math.floor(tick() - playerJoinTimes[userId])
		local sessionTime = playtime
		if playerDataCache[userId] then
			playerDataCache[userId].Playtime = playerDataCache[userId].Playtime + sessionTime
		end
		playerJoinTimes[userId] = nil
	end

	local coins = playerDataCache[userId] and playerDataCache[userId].Coins or 0
	local streak = playerDataCache[userId] and playerDataCache[userId].Streak or 0

	sendWebhookLog(
		"👋 Player Left",
		player.Name .. " has left the game",
		15158332,
		{
			{name = "Session Time", value = tostring(math.floor(playtime / 60)) .. " minutes", inline = true},
			{name = "Coins", value = tostring(coins), inline = true},
			{name = "Streak", value = tostring(streak), inline = true}
		}
	)

	if playerCharacterConnections[userId] then
		playerCharacterConnections[userId]:Disconnect()
		playerCharacterConnections[userId] = nil
	end
	if playerLobbyData[userId] and playerLobbyData[userId].paidEntry then
		local lobbyName = playerLobbyData[userId].lobbyName
		local config = LobbyRewards[lobbyName]
		if config and config.entryFee > 0 then
			addCoins(player, config.entryFee)
		end
	end
	savePlayerData(userId)
	playerDataCache[userId] = nil
	playerLobbyData[userId] = nil
	playerPendingStreaks[userId] = nil
	playerIsLeaving[userId] = nil
	playerBoosters[userId] = nil
	playerActivePotions[userId] = nil

	for lobbyName, lobbyState in pairs(lobbyStates) do
		if lobbyState.gameInProgress then
			if lobbyState.playerChoices[userId] then
				resetLobby(lobbyName, "Opponent left the game.")
				return
			end
		end
	end
end)

spawn(function()
	while true do
		wait(1)
		for userId, boosters in pairs(playerBoosters) do
			local player = Players:GetPlayerByUserId(userId)
			if player then
				local needsUpdate = false

				if boosters.luck and tick() >= boosters.luck.expiresAt then
					boosters.luck = nil
					needsUpdate = true
				end

				if boosters.coins and tick() >= boosters.coins.expiresAt then
					boosters.coins = nil
					needsUpdate = true
				end

				if needsUpdate then
					updatePlayerBoosters(player)
				end
			end
		end

		for userId, potions in pairs(playerActivePotions) do
			local player = Players:GetPlayerByUserId(userId)
			if player then
				local needsUpdate = false

				for i = #potions, 1, -1 do
					if tick() >= potions[i].expiresAt then
						table.remove(potions, i)
						needsUpdate = true
					end
				end

				if needsUpdate then
					updatePlayerPotions(player)
				end
			end
		end
	end
end)

