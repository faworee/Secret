end

local function updatePlayerPotions(player)
	local userId = player.UserId
	local potions = {
		luck = {},
		coin = nil
	}

	if playerActivePotions[userId] then
		for i = #playerActivePotions[userId], 1, -1 do
			local potion = playerActivePotions[userId][i]
			if tick() < potion.expiresAt then
				if potion.type == "luck" then
					table.insert(potions.luck, {
						expiresAt = potion.expiresAt,
						timeLeft = math.floor(potion.expiresAt - tick())
					})
				elseif potion.type == "coin" then
					potions.coin = {
						expiresAt = potion.expiresAt,
						timeLeft = math.floor(potion.expiresAt - tick())
					}
				end
			else
				table.remove(playerActivePotions[userId], i)
			end
		end
	end

	local data = playerDataCache[userId]
	if data then
		updatePotionsEvent:FireClient(player, potions, data.OwnedPotions or {luck = 0, coin = 0})
	end
end

local function activatePotion(player, potionType)
	local userId = player.UserId
	local data = playerDataCache[userId]

	if not data or not data.OwnedPotions then return end

	if potionType == "luck" then
		if data.OwnedPotions.luck <= 0 then return end

		if not playerActivePotions[userId] then
			playerActivePotions[userId] = {}
		end

		local duration = 1800
		table.insert(playerActivePotions[userId], {
			type = "luck",
			expiresAt = tick() + duration,
			active = true
		})

		data.OwnedPotions.luck = data.OwnedPotions.luck - 1

		spawn(function()
			wait(duration)
			updatePlayerPotions(player)
		end)

	elseif potionType == "coin" then
		if data.OwnedPotions.coin <= 0 then return end

		local alreadyActive = false
		if playerActivePotions[userId] then
			for _, potion in ipairs(playerActivePotions[userId]) do
				if potion.type == "coin" and tick() < potion.expiresAt then
					alreadyActive = true
					break
				end
			end
		end

		if alreadyActive then return end

		if not playerActivePotions[userId] then
			playerActivePotions[userId] = {}
		end

		local duration = 3600
		table.insert(playerActivePotions[userId], {
			type = "coin",
			expiresAt = tick() + duration,
			active = true
		})

		data.OwnedPotions.coin = data.OwnedPotions.coin - 1

		spawn(function()
			wait(duration)
			updatePlayerPotions(player)
		end)
	end

	local success = pcall(function()
		PlayerDataStore:SetAsync(tostring(userId), data)
	end)

	updatePlayerPotions(player)
end

