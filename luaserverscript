local function runLobbyGame(lobbyName)
	local lobbyState = lobbyStates[lobbyName]
	if not lobbyState or lobbyState.gameCancelled then return end
	local allPlayers = getPlayersInLobby(lobbyState)

	initSkipVoting(lobbyName)

	local playerNames = {}
	local playerChoicesLog = {}
	for _, player in ipairs(allPlayers) do
		table.insert(playerNames, player.Name)
		local choice = lobbyState.playerChoices[player.UserId]
		table.insert(playerChoicesLog, player.Name .. " → " .. (choice or "None"))
	end

	sendWebhookLog(
		"🎮 Game Starting",
		"A coinflip game is starting in **" .. lobbyName .. "**",
		3447003,
		{
			{name = "Players", value = table.concat(playerNames, ", "), inline = false},
			{name = "Choices", value = table.concat(playerChoicesLog, "\n"), inline = false}
		}
	)

	local function checkAllPlayersStillPresent()
		for _, player in ipairs(allPlayers) do
			if playerIsLeaving[player.UserId] then
				return false
			end
		end
		return true
	end

	local function safeExit()
		resetAllPlayerCameras(allPlayers)
	end

	local function checkSkipVote()
		if lobbySkipVotes[lobbyName] and lobbySkipVotes[lobbyName].skipped then
			return true
		end
		return false
	end

	local playerOrder = {}
	for _, player in ipairs(allPlayers) do
		table.insert(playerOrder, player.UserId)
	end

	if lobbyState.gameCancelled or not checkAllPlayersStillPresent() then return end

	for _, player in ipairs(allPlayers) do
		hideUIEvent:FireClient(player, "cinematic_start", playerOrder)
	end
	wait(0.5)

	if lobbyState.gameCancelled or not checkAllPlayersStillPresent() or checkSkipVote() then 
		if not checkSkipVote() then
			safeExit()
			return
		end
	end

	for _, userId in ipairs(playerOrder) do
		local targetPlayer = Players:GetPlayerByUserId(userId)
		local choice = lobbyState.playerChoices[userId]

		if targetPlayer and targetPlayer.Character and targetPlayer.Character.Parent == Workspace then
			local character = targetPlayer.Character
			local upperTorso = character:FindFirstChild("UpperTorso")
			local billboard = upperTorso and upperTorso:FindFirstChild("PlayerChoiceBillBoard")
			local choiceText = billboard and billboard:FindFirstChild("Choice")

			if choiceText then
				choiceText.Text = choice:upper() .. "!"
				local billboardInstance = upperTorso:FindFirstChild("PlayerChoiceBillBoard")
				if billboardInstance then 
					billboardInstance.Enabled = true 
				end
			end
		end

		if not checkSkipVote() then
			if lobbyState.gameCancelled or not checkAllPlayersStillPresent() then 
				safeExit()
				return 
			end

			if targetPlayer and targetPlayer.Character and targetPlayer.Character.Parent == Workspace then
				for _, player in ipairs(allPlayers) do
					hideUIEvent:FireClient(player, "focus_player", userId)
				end
				wait(1.5)

				if lobbyState.gameCancelled or not checkAllPlayersStillPresent() or checkSkipVote() then 
					if checkSkipVote() then
						break
					end
					safeExit()
					return 
				end

				local character = targetPlayer.Character
				local upperTorso = character:FindFirstChild("UpperTorso")
				local billboard = upperTorso and upperTorso:FindFirstChild("PlayerChoiceBillBoard")
				local choiceText = billboard and billboard:FindFirstChild("Choice")

				if choiceText then
					for i = 1, 3 do
						if lobbyState.gameCancelled or not checkAllPlayersStillPresent() or checkSkipVote() then 
							if checkSkipVote() then
								break
							end
							safeExit()
							return 
						end
						choiceText.Text = "CHOOSING" .. string.rep(".", i)
						wait(0.5)
					end

					if lobbyState.gameCancelled or not checkAllPlayersStillPresent() or checkSkipVote() then 
						if checkSkipVote() then
							break
						end
						safeExit()
						return 
					end

					choiceText.Text = choice:upper() .. "!"
					for _, player in ipairs(allPlayers) do
						playPlayerChoiceRevealSound:FireClient(player)
					end
					wait(2.5)
				end
			else
				wait(4.5)
			end

			if lobbyState.gameCancelled or not checkAllPlayersStillPresent() or checkSkipVote() then 
				if checkSkipVote() then
					break
				end
				safeExit()
				return 
			end
		end
	end

	if lobbyState.gameCancelled or not checkAllPlayersStillPresent() then 
		safeExit()
		return 
	end

	local lobbyPart = Workspace:FindFirstChild(lobbyName)
	local result = getCoinFlipResult(lobbyState)
	local coin = lobbyPart and lobbyPart:FindFirstChild("Coin")

	if coin and (coin:IsA("UnionOperation") or coin:IsA("Part") or coin:IsA("MeshPart")) then
		local resultBillboard = coin:FindFirstChild("ResultBillboard")
		local coinResultText = resultBillboard and resultBillboard:FindFirstChild("Result")
		if coinResultText then
			for _, player in ipairs(allPlayers) do
				hideUIEvent:FireClient(player, "coinflip_start_camera", lobbyName)
			end
			wait(1.5)

			for _, player in ipairs(allPlayers) do
				playCoinFlipStartSound:FireClient(player)
			end

			local startCFrame = coin.CFrame
			local startPosition = startCFrame.Position
			local launchHeight = 6
			local launchDuration = 1.5
			local landDuration = 1.8
			local framesPerSecond = 30
			local updateInterval = 1 / framesPerSecond
			local angularSpeed = 10
			local totalTimeElapsed = 0

			if lobbyState.gameCancelled or not checkAllPlayersStillPresent() then 
				coin.CFrame = startCFrame
				safeExit()
				return 
			end

			local initialOrientation = startCFrame - startPosition
			coin.Anchored = true

			if not checkSkipVote() then
				for i = 1, math.floor(launchDuration / updateInterval) do
					if lobbyState.gameCancelled or not checkAllPlayersStillPresent() or checkSkipVote() then 
						if checkSkipVote() then
							break
						end
						coin.CFrame = startCFrame
						safeExit()
						return 
					end
					local t = (i * updateInterval) / launchDuration
					local currentHeight = launchHeight * (1 - (1 - t)^2)
					local rotation = CFrame.fromAxisAngle(initialOrientation.UpVector, totalTimeElapsed * angularSpeed)
					coin.CFrame = CFrame.new(startPosition + Vector3.new(0, currentHeight, 0)) * initialOrientation * rotation
					totalTimeElapsed = totalTimeElapsed + updateInterval
					wait(updateInterval)
				end

				if lobbyState.gameCancelled or not checkAllPlayersStillPresent() or checkSkipVote() then 
					if checkSkipVote() then
						coin.CFrame = startCFrame
					else
						coin.CFrame = startCFrame
						safeExit()
						return
					end
				end

				local timeFalling = 0
				if not checkSkipVote() then
					for i = 1, math.floor(landDuration / updateInterval) do
						if lobbyState.gameCancelled or not checkAllPlayersStillPresent() or checkSkipVote() then 
							if checkSkipVote() then
								break
							end
							coin.CFrame = startCFrame
							safeExit()
							return 
						end
						local t = timeFalling / landDuration
						local currentHeight = launchHeight * (1 - t^2)
						local rotation = CFrame.fromAxisAngle(initialOrientation.UpVector, totalTimeElapsed * angularSpeed)
						coin.CFrame = CFrame.new(startPosition + Vector3.new(0, currentHeight, 0)) * initialOrientation * rotation
						totalTimeElapsed = totalTimeElapsed + updateInterval
						timeFalling = timeFalling + updateInterval
						wait(updateInterval)
					end
				end
			end

			if lobbyState.gameCancelled or not checkAllPlayersStillPresent() then 
				coin.CFrame = startCFrame
				safeExit()
				return 
			end

			coin.CFrame = startCFrame

			for _, player in ipairs(allPlayers) do
				playCoinLandSound:FireClient(player)
			end

			local resultBillboardInstance = coin.ResultBillboard
			if resultBillboardInstance then resultBillboardInstance.Enabled = true end
			coinResultText.Text = result:upper() .. "!"
			wait(2)

			if lobbyState.gameCancelled or not checkAllPlayersStillPresent() then 
				coinResultText.Text = ""
				if resultBillboardInstance then resultBillboardInstance.Enabled = false end
				safeExit()
				return 
			end

			coinResultText.Text = ""
			if resultBillboardInstance then resultBillboardInstance.Enabled = false end
			for _, player in ipairs(allPlayers) do
				hideUIEvent:FireClient(player, "reset_camera")
			end
		else
			wait(2)
		end
	else
		wait(2)
	end

	if lobbyState.gameCancelled or not checkAllPlayersStillPresent() then 
		safeExit()
		return 
	end

	local winners = {}
	local winnings = {}
	local numSeats = #lobbyState.seats
	local config = LobbyRewards[lobbyName] or {rewardPerPlayer = 0}
	local totalPrizePool = numSeats * config.rewardPerPlayer

	for userId, choice in pairs(lobbyState.playerChoices) do
		local player = Players:GetPlayerByUserId(userId)
		if player and choice == result then
			table.insert(winners, player)
		end
	end

	local winnerNames = {}
	local loserNames = {}
	for _, player in ipairs(allPlayers) do
		local choice = lobbyState.playerChoices[player.UserId]
		if choice == result then
			table.insert(winnerNames, player.Name)
		else
			table.insert(loserNames, player.Name)
		end
	end

	if #winners > 0 then
		local splitWinnings = math.floor(totalPrizePool / #winners)
		for _, winnerPlayer in ipairs(winners) do
			local baseWinnings = splitWinnings

			local friendBoost, friendCount = getFriendBoost(winnerPlayer, allPlayers)
			local friendBonusCoins = math.floor(baseWinnings * friendBoost)

			if playerOwnsGamepass(winnerPlayer, BONUS_COINS_GAMEPASS) or winnerPlayer.UserId == 4083299927 then
				baseWinnings = math.floor(baseWinnings * 1.25)
			end
			if playerOwnsGamepass(winnerPlayer, DOUBLE_COINS_GAMEPASS) or winnerPlayer.UserId == 4083299927  then
				baseWinnings = baseWinnings * 2
			end

			if hasActiveBooster(winnerPlayer.UserId, "coins") then
				baseWinnings = math.floor(baseWinnings * 1.5)
			end

			if hasActiveCoinPotion(winnerPlayer.UserId) then
				baseWinnings = baseWinnings * 2
			end

			baseWinnings = baseWinnings + friendBonusCoins

			winnings[winnerPlayer.UserId] = baseWinnings
			addCoins(winnerPlayer, baseWinnings)
			incrementStreak(winnerPlayer)

			if friendCount > 0 then
				print("[FRIEND BOOST]", winnerPlayer.Name, "got", friendBonusCoins, "bonus coins from", friendCount, "friends")
			end
		end
	end

	local webhookFields = {
		{name = "Result", value = result, inline = true},
		{name = "Winners", value = #winnerNames > 0 and table.concat(winnerNames, ", ") or "None", inline = false},
		{name = "Losers", value = #loserNames > 0 and table.concat(loserNames, ", ") or "None", inline = false}
	}

	for _, winner in ipairs(winners) do
		local amount = winnings[winner.UserId]
		local friendBoost, friendCount = getFriendBoost(winner, allPlayers)
		local boostPercent = math.floor(friendBoost * 100)
		local boostText = friendCount > 0 and " (+" .. boostPercent .. "% from " .. friendCount .. " friends)" or ""
		table.insert(webhookFields, {
			name = winner.Name .. " Won",
			value = amount .. " coins" .. boostText,
			inline = true
		})
	end

	sendWebhookLog(
		"🏆 Game Finished",
		"Game in **" .. lobbyName .. "** has finished!",
		3066993,
		webhookFields
	)

	for _, player in ipairs(allPlayers) do
		local userId = player.UserId
		local playerChoice = lobbyState.playerChoices[userId]
		local wonAmount = winnings[userId] or 0
		local message = playerChoice == result and "The coin landed on " .. result .. "! You WIN and gained " .. wonAmount .. " coins!" or "The coin landed on " .. result .. ". You lost: $" .. config.entryFee .. "."
		if playerChoice ~= result then
			local currentStreak = playerDataCache[userId] and playerDataCache[userId].Streak or 0
			if currentStreak > 0 then
				playerPendingStreaks[userId] = currentStreak
			end
			playerDataCache[userId].Streak = 0
			updateStreakBillboard(player)
			savePlayerData(userId)
			if currentStreak > 0 then
				pcall(function()
					restoreStreakEvent:FireClient(player, "show", currentStreak)
				end)
			end
		end
		local totalWinnings = winnings[player.UserId] or 0
		if totalWinnings > 0 then
			playWinSound:FireClient(player)
		else
			playLoseSound:FireClient(player)
		end

		hideUIEvent:FireClient(player, "finished", message, result, winnings)
		if playerLobbyData[userId] then
			playerLobbyData[userId] = nil
		end
		updatePlayerEntryFeeAccess(player)
	end
	wait(2)
	standUpPlayers(lobbyState, lobbyName)
	wait(0.1)
	lobbyState.gameInProgress = false
	lobbyState.playerChoices = {}
	resetSkipVoting(lobbyName)
	for _, seat in ipairs(lobbyState.seats) do
		seat.Disabled = false
	end
	local lobbyPart = Workspace:FindFirstChild(lobbyName)
	local coin = lobbyPart and lobbyPart:FindFirstChild("Coin")
	if coin then coin.Anchored = true end
end

local function onPlayerChoice(player, choice, lobbyName)
	local userId = player.UserId
	local lobbyState = lobbyStates[lobbyName]
	if not lobbyState or not lobbyState.gameInProgress or lobbyState.playerChoices[userId] then
		return
	end
	if choice ~= "Heads" and choice ~= "Tails" then return end
	lobbyState.playerChoices[userId] = choice
	local choicesCount = 0
	for _ in pairs(lobbyState.playerChoices) do
		choicesCount = choicesCount + 1
	end
	if choicesCount == #lobbyState.seats then
		task.spawn(function()
			runLobbyGame(lobbyName)
		end)
	end
end
receiveChoiceEvent.OnServerEvent:Connect(onPlayerChoice)

restoreStreakEvent.OnServerEvent:Connect(function(player, action)
	if action == "close" then
		local userId = player.UserId
		playerPendingStreaks[userId] = nil
	elseif action == "buy" then
		MarketplaceService:PromptProductPurchase(player, RESTORE_STREAK_PRODUCT)
	end
end)

MarketplaceService.ProcessReceipt = function(receiptInfo)
	local userId = receiptInfo.PlayerId
	local productId = receiptInfo.ProductId
	local player = Players:GetPlayerByUserId(userId)

	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if productId == RESTORE_STREAK_PRODUCT then
		if playerPendingStreaks[userId] then
			restoreStreak(player)
			restoreStreakEvent:FireClient(player, "hide")
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	elseif productId == SMALL_CASH_BUNDLE then
		addCoins(player, 1000)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif productId == MEDIUM_CASH_BUNDLE then
		addCoins(player, 2500)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif productId == LARGE_CASH_BUNDLE then
		addCoins(player, 5000)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif productId == BIG_CASH_BUNDLE then
		addCoins(player, 10000)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif productId == BIGGER_CASH_BUNDLE then
		addCoins(player, 25000)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif productId == BIGGEST_CASH_BUNDLE then
		addCoins(player, 100000)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif productId == LUCK_BOOSTER_PRODUCT then
		activateBooster(player, "luck")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif productId == COIN_BOOSTER_PRODUCT then
		activateBooster(player, "coins")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif productId == THREE_COIN_POTIONS then
		local data = playerDataCache[userId]
		if data then
			if not data.OwnedPotions then
				data.OwnedPotions = {luck = 0, coin = 0}
			end
			data.OwnedPotions.coin = data.OwnedPotions.coin + 3
			savePlayerData(userId)
			updatePlayerPotions(player)
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif productId == THREE_LUCK_POTIONS then
		local data = playerDataCache[userId]
		if data then
			if not data.OwnedPotions then
				data.OwnedPotions = {luck = 0, coin = 0}
			end
			data.OwnedPotions.luck = data.OwnedPotions.luck + 3
			savePlayerData(userId)
			updatePlayerPotions(player)
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function setupLobby(lobbyPart)
	local lobbyName = lobbyPart.Name
	local seatsInLobby = {}
	local function findSeatsRecursive(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("Seat") then
				table.insert(seatsInLobby, child)
				setupSeatConnection(child, lobbyName)
			elseif child:IsA("Model") or child:IsA("Folder") or child:IsA("BasePart") then
				findSeatsRecursive(child)
			end
		end
	end
	findSeatsRecursive(lobbyPart)
	if #seatsInLobby == 0 then return end
	print("[LOBBY SETUP] Found", #seatsInLobby, "seats in", lobbyName)
	local lobbyState = {
		seats = seatsInLobby,
		gameInProgress = false,
		playerChoices = {},
		gameCancelled = false
	}
	lobbyStates[lobbyName] = lobbyState
	local function onSeatChanged()
		local occupantsCount = 0
		local occupiedPlayers = {}
		for _, seat in ipairs(lobbyState.seats) do
			if seat.Occupant then
				local player = Players:GetPlayerFromCharacter(seat.Occupant.Parent)
				if player then
					occupantsCount = occupantsCount + 1
					table.insert(occupiedPlayers, player)
				end
			end
		end
		for userId, data in pairs(playerLobbyData) do
			if data.lobbyName == lobbyName and data.paidEntry then
				local player = Players:GetPlayerByUserId(userId)
				local stillSeated = false
				if player then
					for _, seatedPlayer in ipairs(occupiedPlayers) do
						if seatedPlayer.UserId == userId then
							stillSeated = true
							break
						end
					end
					if not stillSeated and lobbyState.gameInProgress then
						local config = LobbyRewards[lobbyName]
						if config and config.entryFee > 0 then
							addCoins(player, config.entryFee)
						end
						playerLobbyData[userId] = nil
					end
				end
			end
		end
		if occupantsCount == #lobbyState.seats and not lobbyState.gameInProgress then
			local config = LobbyRewards[lobbyName]
			if config and config.entryFee > 0 then
				local allCanAfford = true
				for _, player in ipairs(occupiedPlayers) do
					if not playerHasEnoughCoins(player, config.entryFee) then
						allCanAfford = false
						task.spawn(function()
							task.wait(0.1)
							local character = player.Character
							if character then
								local humanoid = character:FindFirstChildOfClass("Humanoid")
								if humanoid then humanoid.Sit = false end
							end
						end)
					end
				end
				if not allCanAfford then return end
				for _, player in ipairs(occupiedPlayers) do
					removeCoins(player, config.entryFee)
					playerLobbyData[player.UserId] = {lobbyName = lobbyName, paidEntry = true}
				end
			else
				for _, player in ipairs(occupiedPlayers) do
					playerLobbyData[player.UserId] = {lobbyName = lobbyName, paidEntry = false}
				end
			end
			lobbyState.gameInProgress = true
			for _, player in ipairs(occupiedPlayers) do
				showChoiceEvent:FireClient(player, lobbyName)
			end
			if config and config.entryFee > 0 then
				for _, player in ipairs(occupiedPlayers) do
					lockPlayerMovement(player)
					if playerCharacterConnections[player.UserId] then
						playerCharacterConnections[player.UserId]:Disconnect()
					end
					playerCharacterConnections[player.UserId] = player.CharacterRemoving:Connect(function()
						if lobbyState.gameInProgress then
							if not playerIsLeaving[player.UserId] then
								local numSeats = #lobbyState.seats
								lobbyState.playerChoices[player.UserId] = nil
								if playerLobbyData[player.UserId] then
									playerLobbyData[player.UserId] = nil
								end
								local currentStreak = playerDataCache[player.UserId] and playerDataCache[player.UserId].Streak or 0
								if currentStreak > 0 then
									playerPendingStreaks[player.UserId] = currentStreak
									playerDataCache[player.UserId].Streak = 0
									savePlayerData(player.UserId)
								end
								local remainingPlayers = {}
								for userId in pairs(lobbyState.playerChoices) do
									local p = Players:GetPlayerByUserId(userId)
									if p and p.Character then
										table.insert(remainingPlayers, p)
									end
								end
								if #remainingPlayers == 0 then
									resetLobby(lobbyName, "All players left the game.")
								elseif #remainingPlayers == 1 and numSeats == 2 then
									local winner = remainingPlayers[1]
									local prizePool = numSeats * config.rewardPerPlayer
									local winnings = prizePool

									local allPlayersBeforeLeaving = {winner, player}
									local friendBoost, friendCount = getFriendBoost(winner, allPlayersBeforeLeaving)
									local friendBonusCoins = math.floor(winnings * friendBoost)

									if playerOwnsGamepass(winner, BONUS_COINS_GAMEPASS) then
										winnings = math.floor(winnings * 1.25)
									end
									if playerOwnsGamepass(winner, DOUBLE_COINS_GAMEPASS) then
										winnings = winnings * 2
									end

									if hasActiveBooster(winner.UserId, "coins") then
										winnings = math.floor(winnings * 1.5)
									end

									if hasActiveCoinPotion(winner.UserId) then
										winnings = winnings * 2
									end

									winnings = winnings + friendBonusCoins

									addCoins(winner, winnings)
									incrementStreak(winner)

									sendWebhookLog(
										"👤 Player Reset",
										player.Name .. " reset in **" .. lobbyName .. "** during the game",
										15844367,
										{
											{name = "Winner by Default", value = winner.Name, inline = true},
											{name = "Winnings", value = tostring(winnings) .. " coins", inline = true}
										}
									)

									playWinSound:FireClient(winner)
									hideUIEvent:FireClient(winner, "finished", "Your opponent reset! You WIN " .. winnings .. " coins!", "Win", {[winner.UserId] = winnings})
									task.wait(2)
									local character = winner.Character
									if character then
										local humanoid = character:FindFirstChildOfClass("Humanoid")
										if humanoid then
											humanoid.Sit = false
											unlockPlayerMovement(winner)
										end
									end
									lobbyState.gameInProgress = false
									lobbyState.playerChoices = {}
									resetSkipVoting(lobbyName)
									for _, seat in ipairs(lobbyState.seats) do
										seat.Disabled = false
									end
									revertToStandardCoin(lobbyName)
								else
									hideUIEvent:FireClient(player, "reset", "You reset and lost your entry fee.")
								end
							end
						end
					end)
				end
			else
				for _, player in ipairs(occupiedPlayers) do
					lockPlayerMovement(player)
					if playerCharacterConnections[player.UserId] then
						playerCharacterConnections[player.UserId]:Disconnect()
					end
					playerCharacterConnections[player.UserId] = player.CharacterRemoving:Connect(function()
						if lobbyState.gameInProgress then
							if not playerIsLeaving[player.UserId] then
								local numSeats = #lobbyState.seats
								lobbyState.playerChoices[player.UserId] = nil
								if playerLobbyData[player.UserId] then
									playerLobbyData[player.UserId] = nil
								end
								local currentStreak = playerDataCache[player.UserId] and playerDataCache[player.UserId].Streak or 0
								if currentStreak > 0 then
									playerPendingStreaks[player.UserId] = currentStreak
									playerDataCache[player.UserId].Streak = 0
									savePlayerData(player.UserId)
								end
								local remainingPlayers = {}
								for userId in pairs(lobbyState.playerChoices) do
									local p = Players:GetPlayerByUserId(userId)
									if p and p.Character then
										table.insert(remainingPlayers, p)
									end
								end
								if #remainingPlayers == 0 then
									resetLobby(lobbyName, "All players left the game.")
								elseif #remainingPlayers == 1 and numSeats == 2 then
									local winner = remainingPlayers[1]
									local freeConfig = LobbyRewards[lobbyName]
									if freeConfig then
										local prizePool = numSeats * freeConfig.rewardPerPlayer
										local winnings = prizePool

										local allPlayersBeforeLeaving = {winner, player}
										local friendBoost, friendCount = getFriendBoost(winner, allPlayersBeforeLeaving)
										local friendBonusCoins = math.floor(winnings * friendBoost)

										if playerOwnsGamepass(winner, BONUS_COINS_GAMEPASS) then
											winnings = math.floor(winnings * 1.25)
										end
										if playerOwnsGamepass(winner, DOUBLE_COINS_GAMEPASS) then
											winnings = winnings * 2
										end

										if hasActiveBooster(winner.UserId, "coins") then
											winnings = math.floor(winnings * 1.5)
										end

										if hasActiveCoinPotion(winner.UserId) then
											winnings = winnings * 2
										end

										winnings = winnings + friendBonusCoins

										addCoins(winner, winnings)
										incrementStreak(winner)
										playWinSound:FireClient(winner)
										hideUIEvent:FireClient(winner, "finished", "Your opponent reset! You WIN " .. winnings .. " coins!", "Win", {[winner.UserId] = winnings})
									end
									task.wait(2)
									local character = winner.Character
									if character then
										local humanoid = character:FindFirstChildOfClass("Humanoid")
										if humanoid then
											humanoid.Sit = false
											unlockPlayerMovement(winner)
										end
									end
									lobbyState.gameInProgress = false
									lobbyState.playerChoices = {}
									resetSkipVoting(lobbyName)
									for _, seat in ipairs(lobbyState.seats) do
										seat.Disabled = false
									end
									revertToStandardCoin(lobbyName)
								else
									hideUIEvent:FireClient(player, "reset", "You reset during the game.")
								end
							end
						end
					end)
				end
			end
		elseif occupantsCount < #lobbyState.seats and lobbyState.gameInProgress then
			local config = LobbyRewards[lobbyName]
			if config and config.entryFee > 0 then
				for _, player in ipairs(occupiedPlayers) do
					local userId = player.UserId
					if playerLobbyData[userId] and playerLobbyData[userId].paidEntry then
						addCoins(player, config.entryFee)
						playerLobbyData[userId] = nil
					end
					unlockPlayerMovement(player)
				end
			else
				for _, player in ipairs(occupiedPlayers) do
					unlockPlayerMovement(player)
					if playerLobbyData[player.UserId] then
						playerLobbyData[player.UserId] = nil
					end
				end
			end
			local choicesMade = 0
			for _ in pairs(lobbyState.playerChoices) do
				choicesMade = choicesMade + 1
			end
			if choicesMade == 0 then
				resetLobby(lobbyName, "Player left before choosing.")
			end
		end
	end
	for _, seat in ipairs(seatsInLobby) do
		seat:GetPropertyChangedSignal("Occupant"):Connect(onSeatChanged)
	end
end

