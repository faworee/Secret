	updateBoostersEvent:FireClient(player, boosters)
end

local function activateBooster(player, boosterType)
	local userId = player.UserId

	if not playerBoosters[userId] then
		playerBoosters[userId] = {}
	end

	local duration = 3600
	playerBoosters[userId][boosterType] = {
		expiresAt = tick() + duration,
		active = true
	}

	updatePlayerBoosters(player)

	spawn(function()
		wait(duration)
		if playerBoosters[userId] and playerBoosters[userId][boosterType] then
			playerBoosters[userId][boosterType] = nil
			updatePlayerBoosters(player)
		end
	end)
end

