end

local function loadPlayerData(player)
	local userId = player.UserId
	local success, data = pcall(function()
		return PlayerDataStore:GetAsync(tostring(userId))
	end)
	if success and data then
		playerDataCache[userId] = data
		if not playerDataCache[userId].Streak then
			playerDataCache[userId].Streak = 0
		end
		if not playerDataCache[userId].TopStreak then
			playerDataCache[userId].TopStreak = 0
		end
		if not playerDataCache[userId].Playtime then
			playerDataCache[userId].Playtime = 0
		end
		if not playerDataCache[userId].OwnedChairs then
			playerDataCache[userId].OwnedChairs = {}
		end
		if not playerDataCache[userId].EquippedChair then
			playerDataCache[userId].EquippedChair = nil
		end
		if not playerDataCache[userId].OwnedCoins then
			playerDataCache[userId].OwnedCoins = {}
		end
		if not playerDataCache[userId].EquippedCoin then
			playerDataCache[userId].EquippedCoin = nil
		end
		if not playerDataCache[userId].OwnedPotions then
			playerDataCache[userId].OwnedPotions = {luck = 0, coin = 0}
		end
	else
		playerDataCache[userId] = {
			Coins = 0,
			Streak = 0,
			TopStreak = 0,
			Playtime = 0,
			OwnedChairs = {},
			EquippedChair = nil,
			OwnedCoins = {},
			EquippedCoin = nil,
			OwnedPotions = {luck = 0, coin = 0}
		}
	end
	playerJoinTimes[userId] = tick()
	playerIsLeaving[userId] = false

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player
	local coinsValue = Instance.new("IntValue")
	coinsValue.Name = "Coins"
	coinsValue.Value = playerDataCache[userId].Coins
	coinsValue.Parent = leaderstats
	updatePlayerEntryFeeAccess(player)
	updatePlayerBoosters(player)
	updatePlayerPotions(player)
	player.CharacterAdded:Connect(function()
		wait(0.5)
		updateStreakBillboard(player)
		local userId = player.UserId
		if playerPendingStreaks[userId] then
			local pendingStreak = playerPendingStreaks[userId]
			pcall(function()
				restoreStreakEvent:FireClient(player, "show", pendingStreak)
			end)
		end
	end)
	if player.Character then
		updateStreakBillboard(player)
	end
end

