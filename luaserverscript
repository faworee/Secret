local function sendWebhookLog(title, description, color, fields)
	local success, err = pcall(function()
		local embed = {
			["title"] = title,
			["description"] = description,
			["color"] = color or 3447003,
			["fields"] = fields or {},
			["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
		}

		local payload = {
			["embeds"] = {embed}
		}

		HttpService:PostAsync(WEBHOOK_URL, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson, false)
	end)

	if not success then
		warn("[WEBHOOK ERROR]", err)
	end
end

local function getPlayersInLobby(lobbyState)
	local occupiedPlayers = {}
	for _, seat in ipairs(lobbyState.seats) do
		if seat.Occupant then
			local player = Players:GetPlayerFromCharacter(seat.Occupant.Parent)
			if player then
				table.insert(occupiedPlayers, player)
			end
		end
	end
	return occupiedPlayers
end

local function hasActiveBooster(userId, boosterType)
	if not playerBoosters[userId] then return false end
	local booster = playerBoosters[userId][boosterType]
	if not booster then return false end
	return tick() < booster.expiresAt
end

local function hasActiveLuckPotion(userId)
	if not playerActivePotions[userId] then return false, 0 end
	local luckCount = 0

	for i = #playerActivePotions[userId], 1, -1 do
		local potion = playerActivePotions[userId][i]
		if potion.type == "luck" then
			if tick() < potion.expiresAt then
				luckCount = luckCount + 1
			else
				table.remove(playerActivePotions[userId], i)
			end
		end
	end

	return luckCount > 0, luckCount
end

local function hasActiveCoinPotion(userId)
	if not playerActivePotions[userId] then return false end

	for i = #playerActivePotions[userId], 1, -1 do
		local potion = playerActivePotions[userId][i]
		if potion.type == "coin" then
			if tick() < potion.expiresAt then
				return true
			else
				table.remove(playerActivePotions[userId], i)
			end
		end
