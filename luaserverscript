	}
end

local function updateSkipVotesForLobby(lobbyName)
	local lobbyState = lobbyStates[lobbyName]
	if not lobbyState then return end

	local allPlayers = getPlayersInLobby(lobbyState)
	local voteData = lobbySkipVotes[lobbyName]

	if not voteData then return end

	local voteCount = 0
	for _ in pairs(voteData.votes) do
		voteCount = voteCount + 1
	end

	for _, player in ipairs(allPlayers) do
		updateSkipVotesEvent:FireClient(player, voteCount, #allPlayers)
	end
end

skipVoteEvent.OnServerEvent:Connect(function(player, lobbyName)
	local lobbyState = lobbyStates[lobbyName]
	if not lobbyState or not lobbyState.gameInProgress then return end

	if not lobbySkipVotes[lobbyName] then
		initSkipVoting(lobbyName)
	end

	local voteData = lobbySkipVotes[lobbyName]
	if voteData.skipped then return end

	local userId = player.UserId
	if voteData.votes[userId] then return end

	voteData.votes[userId] = true

	local allPlayers = getPlayersInLobby(lobbyState)
	local voteCount = 0
	for _ in pairs(voteData.votes) do
		voteCount = voteCount + 1
	end

	updateSkipVotesForLobby(lobbyName)

	if voteCount >= #allPlayers then
		voteData.skipped = true
	end
end)

local function getFriendBoost(player, otherPlayers)
	local friendCount = 0

	for _, otherPlayer in ipairs(otherPlayers) do
		if otherPlayer ~= player then
			local success, isFriend = pcall(function()
				return player:IsFriendsWith(otherPlayer.UserId)
			end)

			if success and isFriend then
				friendCount = friendCount + 1
			end
		end
	end

	local boostMultiplier = math.min(friendCount * 0.1, 1.0)
	return boostMultiplier, friendCount
end

local function replaceChairDecoration(seat, decorationModel)
	local chairModel = seat.Parent
	if not chairModel then
		return
	end

	local existingDecoration = chairModel:FindFirstChild("Decoration")
	local savedCFrame = nil

	if existingDecoration then
		if existingDecoration:IsA("BasePart") then
			savedCFrame = existingDecoration.CFrame
		elseif existingDecoration:IsA("Model") and existingDecoration.PrimaryPart then
			savedCFrame = existingDecoration:GetPrimaryPartCFrame()
		elseif existingDecoration:IsA("Model") then
			local firstPart = existingDecoration:FindFirstChildWhichIsA("BasePart", true)
			if firstPart then
				savedCFrame = firstPart.CFrame
			end
		end
		existingDecoration:Destroy()
	end

	if decorationModel then
		local newDecoration = decorationModel:Clone()
		newDecoration.Name = "Decoration"

		if savedCFrame then
			if newDecoration:IsA("BasePart") then
				newDecoration.CFrame = savedCFrame
			elseif newDecoration:IsA("Model") and newDecoration.PrimaryPart then
				newDecoration:SetPrimaryPartCFrame(savedCFrame)
			elseif newDecoration:IsA("Model") then
				local firstPart = newDecoration:FindFirstChildWhichIsA("BasePart", true)
				if firstPart then
					local offset = savedCFrame * firstPart.CFrame:Inverse()
					for _, descendant in ipairs(newDecoration:GetDescendants()) do
						if descendant:IsA("BasePart") then
							descendant.CFrame = offset * descendant.CFrame
						end
					end
				end
			end
		end

		newDecoration.Parent = chairModel
	end
end

local function replaceCoinInLobby(lobbyName, coinModel)
	local lobbyPart = Workspace:FindFirstChild(lobbyName)
	if not lobbyPart then return end

	local existingCoin = lobbyPart:FindFirstChild("Coin")
	if not existingCoin then return end

	local savedCFrame = existingCoin.CFrame
	existingCoin:Destroy()

	if coinModel then
		local newCoin = coinModel:Clone()
		newCoin.Name = "Coin"
		newCoin.CFrame = savedCFrame
		newCoin.Anchored = true

		local resultBillboard = newCoin:FindFirstChild("ResultBillboard")
		if resultBillboard then
			resultBillboard:Destroy()
		end

		if ResultBillboard then
			local billboardClone = ResultBillboard:Clone()
			billboardClone.Parent = newCoin
		end

		newCoin.Parent = lobbyPart
	end
end

local function applyCoinSkin(lobbyName, player)
	if lobbyCoinOwners[lobbyName] then
		return
	end

	lobbyCoinOwners[lobbyName] = player.UserId

	local userId = player.UserId
	local data = playerDataCache[userId]

	if not data or not data.EquippedCoin then
		replaceCoinInLobby(lobbyName, StandardCoinFolder)
		return
	end

	local coinSkin = CoinSkinsFolder:FindFirstChild(data.EquippedCoin)
	if not coinSkin then
		local nameWithoutSpaces = data.EquippedCoin:gsub("%s+", "")
		coinSkin = CoinSkinsFolder:FindFirstChild(nameWithoutSpaces)
	end

	if coinSkin then
		replaceCoinInLobby(lobbyName, coinSkin)
	else
		replaceCoinInLobby(lobbyName, StandardCoinFolder)
	end
end

local function revertToStandardCoin(lobbyName)
	lobbyCoinOwners[lobbyName] = nil
	replaceCoinInLobby(lobbyName, StandardCoinFolder)
end

local function applyChairSkin(player, seat)
	local userId = player.UserId
	local data = playerDataCache[userId]
	if not data or not data.EquippedChair then
		local standardDecoration = StandardChairFolder:FindFirstChild("Decoration")
		if standardDecoration then
			replaceChairDecoration(seat, standardDecoration)
		end
		return
	end
	local chairSkin = FlowerSkinsFolder:FindFirstChild(data.EquippedChair)
	if not chairSkin then
		local nameWithoutSpaces = data.EquippedChair:gsub("%s+", "")
		chairSkin = FlowerSkinsFolder:FindFirstChild(nameWithoutSpaces)
	end
	if chairSkin then
		local decoration = chairSkin:FindFirstChild("Decoration")
		if decoration then
			replaceChairDecoration(seat, decoration)
		end
	else
		local standardDecoration = StandardChairFolder:FindFirstChild("Decoration")
		if standardDecoration then
			replaceChairDecoration(seat, standardDecoration)
		end
	end
end

local function revertToStandardChair(seat)
	local standardDecoration = StandardChairFolder:FindFirstChild("Decoration")
	if standardDecoration then
		replaceChairDecoration(seat, standardDecoration)
	end
end

local function setupSeatConnection(seat, lobbyName)
	local currentPlayer = nil

	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if seat.Occupant then
			local character = seat.Occupant.Parent
			local player = Players:GetPlayerFromCharacter(character)
			if player then
				currentPlayer = player
				applyChairSkin(player, seat)

				if lobbyName and not lobbyCoinOwners[lobbyName] then
					applyCoinSkin(lobbyName, player)
				end

				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					local diedConnection
					diedConnection = humanoid.Died:Connect(function()
						revertToStandardChair(seat)
						if currentPlayer and lobbyName and lobbyCoinOwners[lobbyName] == currentPlayer.UserId then
							revertToStandardCoin(lobbyName)
						end
						currentPlayer = nil
						if diedConnection then
							diedConnection:Disconnect()
						end
					end)
				end
			end
		else
			revertToStandardChair(seat)
			if currentPlayer and lobbyName and lobbyCoinOwners[lobbyName] == currentPlayer.UserId then
				revertToStandardCoin(lobbyName)
			end
			currentPlayer = nil
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if currentPlayer == player then
			revertToStandardChair(seat)
			if lobbyName and lobbyCoinOwners[lobbyName] == player.UserId then
				revertToStandardCoin(lobbyName)
			end
			currentPlayer = nil
		end
	end)
end

